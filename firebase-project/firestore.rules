rules_version = '2';

// Fresh Orbit security rules.
service cloud.firestore {
  match /databases/{database}/documents {

    // Who can manage the shop:
    //  - the main owner below, always (so the shop can never be locked out), and
    //  - every email in the admin list, which admins edit on the dashboard's Admins tab.
    // Each admin also needs a login under Firebase > Authentication > Users, and
    // (except the main owner) must have clicked the verification email, so nobody
    // can sign up with an admin's email address before the real person does.
    function mainOwner() {
      return "mosasiva6@gmail.com";
    }

    function isOwner() {
      return request.auth != null
        && request.auth.token.email is string
        && (request.auth.token.email.lower() == mainOwner()
            || (request.auth.token.email_verified == true
                && exists(/databases/$(database)/documents/admins/list)
                && request.auth.token.email.lower()
                   in get(/databases/$(database)/documents/admins/list).data.emails));
    }

    function money(n) {
      return n is int && n >= 0 && n <= 500000;
    }

    // Admin list: only admins can see or change it. Customers never see these emails.
    match /admins/{docId} {
      allow read: if isOwner();
      allow write: if isOwner()
        && docId == "list"
        && request.resource.data.keys().hasOnly(["emails", "updatedBy", "updatedAt"])
        && request.resource.data.emails is list
        && request.resource.data.emails.size() <= 25;
    }

    // Shop settings (WhatsApp number, delivery areas, banner...): public read, owner write.
    match /shop/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Product catalogue: public read, owner write.
    match /products/{productId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Orders: any customer can place one; only the owner can see or change them.
    match /orders/{orderId} {
      allow create: if validNewOrder(request.resource.data);
      allow read, update, delete: if isOwner();
    }

    function validNewOrder(o) {
      return o.keys().hasAll(['items', 'subtotal', 'delivery', 'total', 'name', 'phone',
                              'area', 'address', 'slot', 'status', 'createdAt',
                              'ref', 'payMethod', 'payStatus'])
        && o.keys().hasOnly(['items', 'subtotal', 'delivery', 'total', 'name', 'phone',
                             'area', 'address', 'slot', 'note', 'status', 'createdAt',
                             'ref', 'payMethod', 'payStatus'])
        && o.status == 'new'
        && o.ref is string && o.ref.matches('^FO-[A-Z0-9]{4}$')
        && o.payMethod in ['upi', 'cod']
        && o.payStatus == 'unpaid'
        && o.items is list
        && o.items.size() >= 1
        && o.items.size() <= 30
        && money(o.subtotal)
        && money(o.delivery)
        && money(o.total)
        && o.total == o.subtotal + o.delivery
        && o.subtotal >= 1
        && o.name is string && o.name.size() > 0 && o.name.size() <= 80
        && o.phone is string && o.phone.matches('^[6-9][0-9]{9}$')
        && o.area is string && o.area.size() <= 80
        && o.address is string && o.address.size() > 0 && o.address.size() <= 400
        && o.slot is string && o.slot.size() <= 40
        && (!('note' in o) || (o.note is string && o.note.size() <= 300))
        && o.createdAt == request.time;
    }
  }
}
